# Vectorize Hindsight Cloud Configuration (Required)
HINDSIGHT_API_KEY="your_hindsight_api_key_here"
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"

# Neon Serverless PostgreSQL Configuration (Required for persistence)
NEON_DATABASE_URL="postgresql://user:password@ep-your-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google Workspace Integration (Desktop OAuth Client Secret)
GOOGLE_CLIENT_SECRET_FILE="path/to/client_secret.json"
GOOGLE_TOKEN_FILE="token.json"
